{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-icon",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/TyxMatty/*"
        }
      ]
    }
  ]
}
